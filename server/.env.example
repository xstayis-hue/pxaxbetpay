# PXAX Core API configuration
PORT=3000

# Telegram bot token used to validate Mini App initData (HMAC check).
# Get it from @BotFather for the bot that serves pxaxbetpay (e.g. @PxAxBetPay_bot).
PXAX_BOT_TOKEN=

# Secret key required in Authorization: Bearer <key> header for /api/admin/* routes.
# Generate a long random value, never commit the real value.
PXAX_ADMIN_KEY=

# Comma-separated list of origins allowed to call this API (GitHub Pages, custom domain, etc.)
# Example: https://xstayis-hue.github.io,https://pxax.example.com
PXAX_ALLOWED_ORIGINS=

# Optional custom sqlite file path. Defaults to server/pxax.sqlite
PXAX_DB_PATH=
